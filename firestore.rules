rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDebtSpaceMember(spaceId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/debtSpaces/$(spaceId))
        && request.auth.uid in get(/databases/$(database)/documents/debtSpaces/$(spaceId)).data.memberIds;
    }

    match /users/{userId}/private/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /debtSpaces/{spaceId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if false;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.inviteTokenHash == resource.data.inviteTokenHash
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      match /entries/{entryId} {
        allow read: if isDebtSpaceMember(spaceId);
        allow create: if isDebtSpaceMember(spaceId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type in ['note', 'payment', 'correction', 'agreement'];
        allow update, delete: if isDebtSpaceMember(spaceId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
